# Copy to .env.local for local dev, and set the same names in Vercel's
# Environment Variables for Production/Preview. Values below are placeholders.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alternate name some code paths also accept for the anon/publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Canonical production origin, no trailing slash. Falls back to
# https://life-cfo.com in code if unset.
NEXT_PUBLIC_SITE_URL=

# --- Beta access ---
# Comma-separated. Both FAIL CLOSED if unset — invite redemption and
# allowlist sign-in silently reject everyone rather than silently allowing.
LIFE_CFO_BETA_INVITE_CODES=
LIFE_CFO_BETA_EMAIL_ALLOWLIST=

# --- AI ---
# Must be the exact string "true" to turn AI chat on. Fails safe (off) if unset.
LIFE_CFO_AI_ENABLED=
# "openai" or "anthropic".
LIFE_CFO_AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FRAME=
# Daily caps. Both have safe built-in defaults (15 per user, 200 per
# household) if unset.
LIFE_CFO_AI_DAILY_LIMIT_PER_USER=
LIFE_CFO_AI_DAILY_LIMIT_TOTAL=

# --- Bank connections (compiled off for beta — see lib/flags/bankConnect.ts) ---
# These are only read if that compile-time flag is ever flipped back on.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_SANDBOX_SECRET=
PLAID_ENV=
PLAID_PRODUCTS=
PLAID_COUNTRY_CODES=
PLAID_REDIRECT_URI=
# Versioned key, e.g. PLAID_TOKEN_ENCRYPTION_KEY_V1 — name must match
# PLAID_TOKEN_ENCRYPTION_ACTIVE_VERSION below.
PLAID_TOKEN_ENCRYPTION_KEY_V1=
PLAID_TOKEN_ENCRYPTION_ACTIVE_VERSION=
PLAID_TOKEN_ALLOWED_SUPABASE_URLS=
PLAID_TOKEN_MAINTENANCE_ENABLED=
BASIQ_API_KEY=
BASIQ_BASE_URL=
BASIQ_VERSION=

# --- Engine cron (currently disabled for beta — routes return 410) ---
CRON_SECRET=
ENGINE_CRON_SECRET=

# --- Local dev only ---
DEV_EMAIL=
DEV_PASSWORD=
